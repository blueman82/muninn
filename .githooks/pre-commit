#!/bin/sh
# Block any commit that fails the engineering standards gate
# (docs/STANDARDS.md). Install once: git config core.hooksPath .githooks
set -eu
root=$(git rev-parse --show-toplevel)
# A hook inherits GIT_DIR and friends. Committing from a linked worktree points
# them inside the shared .git, and a test that runs `git init` in a temp dir
# would then mark the real repository bare. Run the gate with a clean git
# environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH \
  GIT_NAMESPACE
cd "$root"
exec "${MUNINN_PYTHON:-python3.13}" -m tools.check --full
