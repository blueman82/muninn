{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && .venv/bin/python3.13 -m tools.check >&2 || exit 2",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
