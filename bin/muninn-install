#!/bin/sh
# Install or upgrade muninn from this checkout at its HEAD.
#   bin/muninn-install           fresh install, or upgrade when already installed
#   bin/muninn-install --check   preview; may set up .venv and Git hooks
#   bin/muninn-install --status  installed commit against this checkout's HEAD
#   bin/muninn-install --uninstall [--dry-run] [--purge-data]  remove muninn
#   bin/muninn-install --help    describe the above
# Any other arguments go straight to install.installer (--repo, --sha, ...).
# Interpreter order is bin/muninn's (ADR 0003).
set -eu
self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")
lib=${HOME:-/nonexistent}/.local/lib/muninn
data=${HOME:-/nonexistent}/.local/share/muninn
py=${MUNINN_PYTHON:-}
[ -x "$py" ] || py=$lib/python
# Invoke the venv path, not its outer alias: Python uses that path to find pyvenv.cfg.
if [ "$py" = "$lib/python" ] && [ -L "$py" ]; then
  py=$(readlink "$py")
fi
if [ ! -x "$py" ]; then
  py=
  for c in python3.13 python3.14 python3; do
    found=$(command -v "$c" 2>/dev/null) || continue
    "$found" -c 'import sys; sys.exit(sys.version_info < (3, 13))' \
      2>/dev/null || continue
    py=$found
    break
  done
fi
if [ -z "$py" ]; then
  echo "muninn-install: no Python 3.13+ found;" \
    "set MUNINN_PYTHON=/path/to/python3.13" >&2
  exit 127
fi
env_python=$root/.venv/bin/python3
if [ "$("$py" -E -s -c 'import sys; print(sys.platform)')" = win32 ]; then
  env_python=$root/.venv/Scripts/python.exe
fi

ensure_runtime() {
  if "$py" -E -s -c \
    'import pydantic, sys; sys.exit(pydantic.__version__ != "2.14.0")' \
    >/dev/null 2>&1; then
    return
  fi
  if [ -x "$env_python" ] && "$env_python" -E -s -c \
    'import pydantic, sys; sys.exit(pydantic.__version__ != "2.14.0")' \
    >/dev/null 2>&1; then
    py=$env_python
    return
  fi
  printf 'Pinned runtime dependencies are missing or incompatible. Set up %s/.venv and continue? [y/N] ' \
    "$root" >&2
  IFS= read -r answer || answer=
  case "$answer" in
    [yY]*) ;;
    [nN]* | '') echo "muninn-install: setup declined; no install was run" >&2; exit 1 ;;
    *) echo "muninn-install: answer y or n; no install was run" >&2; exit 1 ;;
  esac
  "$py" -m venv "$root/.venv" || {
    echo "muninn-install: could not create $root/.venv" >&2
    exit 1
  }
  "$env_python" -m pip install --require-hashes \
    -r "$root/requirements-runtime.lock" || {
    echo "muninn-install: could not install pinned runtime dependencies" >&2
    exit 1
  }
  "$env_python" -E -s -c \
    'import pydantic, sys; sys.exit(pydantic.__version__ != "2.14.0")' \
    >/dev/null 2>&1 || {
    echo "muninn-install: runtime dependency check failed in $root/.venv" >&2
    exit 1
  }
  py=$env_python
}

ensure_git_hooks() {
  hook_path=$(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
    git -C "$root" config --get core.hooksPath || true)
  [ "$hook_path" = .githooks ] && return
  if [ -n "$hook_path" ]; then
    echo "muninn-install: existing Git hooks path left unchanged: $hook_path" >&2
    return
  fi
  printf "Enable this checkout's Git hooks? This sets up .venv and developer tools. [y/N] " >&2
  IFS= read -r answer || answer=
  case "$answer" in
    [yY]*) ;;
    *) echo "muninn-install: Git hooks not enabled" >&2; return ;;
  esac
  if [ ! -x "$env_python" ]; then
    "$py" -m venv "$root/.venv" || {
      echo "muninn-install: could not create $root/.venv" >&2
      return 1
    }
  fi
  "$env_python" -E -s -c \
    'import pydantic, sys; sys.exit(pydantic.__version__ != "2.14.0")' \
    >/dev/null 2>&1 || "$env_python" -m pip install --require-hashes \
    -r "$root/requirements-runtime.lock" || {
    echo "muninn-install: could not install pinned runtime dependencies" >&2
    return 1
  }
  "$env_python" -m pip install --require-hashes -r "$root/requirements-dev.txt" || {
    echo "muninn-install: could not install locked developer tools;" \
      "check network, supported wheels and requirements-dev.txt hashes" >&2
    return 1
  }
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
    git -C "$root" config --local core.hooksPath .githooks
}

# Removing needs no commit, so it must work where git is missing or this
# copy of the repo is not a git checkout.
if [ "${1:-}" = --uninstall ]; then
  shift
  cd "$root"
  exec "$py" -E -s -B -m install.uninstall "$@"
fi

# A commit hook exports these; git would then act on the wrong repository.
head=$(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
  git -C "$root" rev-parse HEAD)
short=$(printf %s "$head" | cut -c1-7)
installed=
if [ -L "$lib/current" ]; then
  installed=$(readlink "$lib/current")
fi
if [ -n "$installed" ] && [ -d "$data" ]; then
  mode=upgrade
elif [ -z "$installed" ] && [ ! -e "$data" ]; then
  mode=fresh
else
  mode=half
fi

case "${1:-}" in
  -h | --help)
    cat <<'HELP'
usage: bin/muninn-install [--check | --status | --uninstall]

Install or upgrade muninn from this checkout at its HEAD. It picks a fresh
install or an upgrade by looking at what is on this machine.

  (no argument)  install or upgrade, restart the poller, run doctor
  --check        preview; may set up .venv and enable repository Git hooks
  --status       show the installed commit against this checkout's HEAD
  --uninstall    remove muninn (bin/muninn-uninstall); takes --dry-run and
                 --purge-data

Advanced: any other arguments go straight to install.installer
(--repo, --sha, --fresh, --upgrade, --dry-run, --home). Details are in
docs/REFERENCE.md.
HELP
    exit 0
    ;;
  --status)
    installed_sha=${installed##*/}
    if [ "$mode" = fresh ]; then
      echo "not installed; checkout is at $short"
    elif [ "$mode" = half ]; then
      echo "half-installed: data directory and current release link disagree;" \
        "inspect installation before installing; checkout $short"
    elif [ "$installed_sha" = "$head" ]; then
      echo "installed $short, checkout $short: up to date"
    else
      relation="versions differ; ancestry unknown; inspect versions before installing"
      installed_short=unknown
      case "$installed_sha" in
        *[!0-9a-f]* | '') ;;
        *)
          if [ "${#installed_sha}" -eq 40 ]; then
            installed_short=$(printf %s "$installed_sha" | cut -c1-7)
            older=0
            newer=0
            env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
              GIT_NO_LAZY_FETCH=1 GIT_ALLOW_PROTOCOL= git -C "$root" merge-base --is-ancestor \
              "$installed_sha" "$head" 2>/dev/null || older=$?
            env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
              GIT_NO_LAZY_FETCH=1 GIT_ALLOW_PROTOCOL= git -C "$root" merge-base --is-ancestor \
              "$head" "$installed_sha" 2>/dev/null || newer=$?
            if [ "$older" -eq 0 ]; then
              relation="checkout is newer; upgrade available; preview with bin/muninn-install --check"
            elif [ "$newer" -eq 0 ]; then
              relation="installed version is newer; update this checkout before installing"
            elif [ "$older" -eq 1 ] && [ "$newer" -eq 1 ] && \
              [ "$(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
                git -C "$root" rev-parse --is-shallow-repository)" = false ]; then
              relation="versions differ; histories diverged; inspect versions before installing"
            fi
          fi
          ;;
      esac
      echo "installed $installed_short," \
        "checkout $short: $relation"
    fi
    exit 0
    ;;
  --check | "") ;;
  *)
    ensure_runtime
    ensure_git_hooks
    cd "$root"
    exec "$py" -E -s -B -m install.installer "$@"
    ;;
esac

if [ "$mode" = half ]; then
  echo "muninn-install: half-installed: the data dir and the current" \
    "release link disagree; fix that by hand first" >&2
  exit 1
fi

ensure_runtime
ensure_git_hooks

cd "$root"
if [ "${1:-}" = --check ]; then
  if [ "$mode" = upgrade ]; then
    echo "Upgrade: $(printf %s "$installed" | cut -c1-7) -> $short"
  else
    echo "Fresh install of $short"
  fi
  "$py" -E -s -B -m install.installer --repo "$root" --sha "$head" \
    "--$mode" --dry-run
  echo "OK to run: bin/muninn-install"
else
  "$py" -E -s -B -m install.installer --repo "$root" --sha "$head" "--$mode"
  pid=$(sed -n 's/.*"pid": *\([0-9][0-9]*\).*/\1/p' \
    "$data/status.json" 2>/dev/null || true)
  echo "installed $short ($mode); poller pid ${pid:-unknown}; doctor ok;" \
    "log: $lib/install.log"
fi
