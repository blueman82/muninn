#!/bin/sh
# Interpreter (first that exists): $MUNINN_PYTHON, the link the installer wrote
# at ~/.local/lib/muninn/python, then python3.13+ on PATH.
set -eu
self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")
py=${MUNINN_PYTHON:-}
[ -x "$py" ] || py=${HOME:-/nonexistent}/.local/lib/muninn/python
if [ ! -x "$py" ]; then
  py=
  for c in python3.13 python3.14 python3; do
    found=$(command -v "$c" 2>/dev/null) || continue
    "$found" -c 'import sys; sys.exit(sys.version_info < (3, 13))' \
      2>/dev/null || continue
    py=$found
    break
  done
fi
if [ -z "$py" ]; then
  echo "muninn: no Python 3.13+ found; set MUNINN_PYTHON=/path/to/python3.13" >&2
  exit 127
fi
exec "$py" -I -B -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
from muninn.cli import main
raise SystemExit(main(sys.argv[1:]))
' "$root" "$@"
