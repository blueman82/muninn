#!/bin/sh
# Install or upgrade pctx from this checkout at its HEAD.
#   bin/pctx-install           fresh install, or upgrade when already installed
#   bin/pctx-install --check   say what would happen; write nothing
#   bin/pctx-install --status  installed commit against this checkout's HEAD
# Any other arguments go straight to install.installer (--repo, --sha, ...).
# Interpreter order is bin/pctx's (ADR 0003).
set -eu
self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")
lib=${HOME:-/nonexistent}/.local/lib/provenance-context
data=${HOME:-/nonexistent}/.local/share/provenance-context
py=${PCTX_PYTHON:-}
[ -x "$py" ] || py=$lib/python
if [ ! -x "$py" ]; then
  py=
  for c in python3.13 python3.14 python3; do
    found=$(command -v "$c" 2>/dev/null) || continue
    "$found" -c 'import sys; sys.exit(sys.version_info < (3, 13))' \
      2>/dev/null || continue
    py=$found
    break
  done
fi
if [ -z "$py" ]; then
  echo "pctx-install: no Python 3.13+ found;" \
    "set PCTX_PYTHON=/path/to/python3.13" >&2
  exit 127
fi

# A commit hook exports these; git would then act on the wrong repository.
head=$(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE \
  git -C "$root" rev-parse HEAD)
short=$(printf %s "$head" | cut -c1-7)
installed=
if [ -L "$lib/current" ]; then
  installed=$(readlink "$lib/current")
fi
if [ -n "$installed" ] && [ -d "$data" ]; then
  mode=upgrade
elif [ -z "$installed" ] && [ ! -e "$data" ]; then
  mode=fresh
else
  mode=half
fi

case "${1:-}" in
  --status)
    if [ "$mode" = fresh ]; then
      echo "not installed; checkout is at $short"
    elif [ "$installed" = "$head" ]; then
      echo "installed $short, checkout $short: up to date"
    else
      echo "installed $(printf %s "$installed" | cut -c1-7)," \
        "checkout $short: upgrade needed"
    fi
    exit 0
    ;;
  --check | "") ;;
  *)
    cd "$root"
    exec "$py" -E -s -B -m install.installer "$@"
    ;;
esac

if [ "$mode" = half ]; then
  echo "pctx-install: half-installed: the data dir and the current" \
    "release link disagree; fix that by hand first" >&2
  exit 1
fi

cd "$root"
if [ "${1:-}" = --check ]; then
  if [ "$mode" = upgrade ]; then
    echo "Upgrade: $(printf %s "$installed" | cut -c1-7) -> $short"
  else
    echo "Fresh install of $short"
  fi
  "$py" -E -s -B -m install.installer --repo "$root" --sha "$head" \
    "--$mode" --dry-run
  echo "OK to run: bin/pctx-install"
else
  "$py" -E -s -B -m install.installer --repo "$root" --sha "$head" "--$mode"
  echo "installed $short ($mode); doctor ok; log: $lib/install.log"
fi
