{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/muninn hook session-start --provider claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/muninn hook prompt --provider claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
